# Renombra este archivo a .env.local y llena los valores
# NUNCA subas .env.local a GitHub
#
# Toda variable EXPO_PUBLIC_* se hornea en el bundle de JavaScript y es
# extraíble de cualquier APK/IPA: aquí SOLO van valores públicos por diseño
# (URL del proyecto, anon key protegida por RLS, URL del proxy de IA).
# Un secreto real en este archivo es un secreto filtrado.

# ─── REQUERIDAS ───────────────────────────────────────────
# Supabase → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Proxy de IA (obligatoria: sin ella la app se queda sin IA). La app llama a
# esta URL con el JWT del usuario; lib/aiClient.ts NO tiene ningún camino
# directo al proveedor de IA y lanza "IA no disponible: falta configurar el
# proxy de IA" si esta variable está vacía.
EXPO_PUBLIC_AI_PROXY_URL=https://XXXXXXXXXX.functions.supabase.co/ai-proxy

# ─── Secretos del SERVIDOR (NO van aquí, se configuran con la CLI) ───
# La key de OpenAI vive SOLO en el servidor. La variable de cliente
# EXPO_PUBLIC_OPENAI_API_KEY fue RETIRADA junto con el fallback directo a
# OpenAI: no la vuelvas a agregar ni siquiera "solo para desarrollo", porque
# quedaría dentro del bundle.
# supabase secrets set OPENAI_API_KEY=sk-...
# supabase secrets set AI_DAILY_LIMIT=50

# ─── PostHog (product analytics + session replay + feature flags) ───
# La project key (phc_) es PUBLICA por diseño: solo permite ENVIAR eventos y
# se puede extraer del APK. NO uses aquí una personal key (phx_): esa es un
# secreto con acceso completo a la API de tu cuenta.
# Sin estas variables la integración es un no-op silencioso y la app funciona
# igual — útil para desarrollo local sin ensuciar los datos del proyecto.
EXPO_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Sentry (errores de producción) ───────────────────────
# El DSN es público por diseño: solo permite ENVIAR eventos.
EXPO_PUBLIC_SENTRY_DSN=https://XXXXXXXX@oXXXXXX.ingest.us.sentry.io/XXXXXXX

# ─── RevenueCat (compras) ─────────────────────────────────
# Las claves de SDK (goog_ / appl_) son PUBLICAS por diseño: van dentro de la
# app y solo sirven para operar sobre la cuenta del propio usuario.
# NO uses aquí la secret key (sk_): esa manda en toda tu cuenta y va SOLO en el
# servidor, con `supabase secrets set REVENUECAT_SECRET_KEY=sk_...`.
#
# Ojo: esto se hornea AL COMPILAR. Un AAB construido sin la clave lleva el
# paywall muerto —lib/purchases.ts corta en `if (!P || !API_KEY) return null`—
# y no se arregla configurando nada después: hay que volver a compilar.
EXPO_PUBLIC_RC_API_KEY_ANDROID=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Solo cuando haya app de iOS:
# EXPO_PUBLIC_RC_API_KEY_IOS=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Secretos de RevenueCat en el SERVIDOR ───
# supabase secrets set REVENUECAT_SECRET_KEY=sk_...   (para sync-premium)
# supabase secrets set RC_WEBHOOK_SECRET=<aleatorio largo>  (para rc-webhook)
